# The private runtime is BUILT, never committed. Beyond being ~180 MB, it contains
# third-party binaries that are not ours to redistribute: RTSS is proprietary freeware,
# LibreHardwareMonitor is MPL-2.0, CPython is under the PSF licence. bootstrap.ps1
# fetches each from its official source instead.
runtime/

# Runtime state
state/
events.jsonl
*.log

# The working config is user data, seeded from config.default.toml by bootstrap.ps1
# (in a checkout) or on first run (in an install). Only the template is committed,
# so the two cannot drift apart.
config.toml

# Built installers
dist/

# Generated by generate_assets.py (bootstrap.ps1 runs it for you)
assets/*.wav

# Python
__pycache__/
*.py[cod]

# Sandbox test output
sandbox/results/*
!sandbox/results/.gitkeep
